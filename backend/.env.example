# Lead Shark Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
SECRET_KEY=leadshark-super-secure-production-ready-jwt-secret-key-2026

# Database Configuration:
# - Local Development: defaults to SQLite if DATABASE_URL is not set:
DATABASE_URL=sqlite:///./leadshark.db

# - Production on Render:
#   Set DATABASE_URL to your Render PostgreSQL connection string (Internal Database URL):
#   Example: postgresql://leadshark_user:your_password@dpg-xxxx-a.oregon-postgres.render.com/leadshark
# - Production on Supabase:
#   Example: postgresql://postgres.your-project:your_password@aws-0-region.pooler.supabase.com:6543/postgres

FRONTEND_URL=https://leadshark.vercel.app

# Seed Accounts
ADMIN_EMAIL=admin@leadshark.io
ADMIN_PASSWORD=AdminLeadShark2026!
REVIEWER_EMAIL=reviewer@leadshark.io
REVIEWER_PASSWORD=ReviewerLeadShark2026!
SALES_EMAIL=sales@leadshark.io
SALES_PASSWORD=SalesLeadShark2026!
